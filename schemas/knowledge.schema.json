{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^knowledge\\.[a-z][a-z0-9_]*$"
    },
    "name_de": {
      "type": "string"
    },
    "acquisition": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "instruction",
          "scenario"
        ]
      },
      "minItems": 1
    },
    "notes_de": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "name_de",
    "acquisition",
    "notes_de"
  ],
  "additionalProperties": false
}
